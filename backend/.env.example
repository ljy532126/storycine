# ========== JWT 密钥（必填，用于签发登录 Token） ==========
JWT_SECRET=请替换为随机字符串（至少32位）

# ========== 服务端口 ==========
SERVER_PORT=3012

# ========== MongoDB ==========
MONGO_URI=mongodb://admin:admin123@localhost:27017/storycine?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=storycine
MONGO_USER=storycine_user
MONGO_PASSWORD=storycine_pass
MONGO_AUTH_SOURCE=storycine

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== MinIO ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storycine

