# ========== JWT 密钥（必填，用于签发登录 Token） ==========
JWT_SECRET=请替换为随机生成的32位以上字符串

# ========== 字段加密密钥（必填，用于加密存储 API Key 等敏感字段） ==========
ENCRYPTION_KEY=请替换为随机生成的32位以上字符串

# ========== 管理员账号（首次启动自动创建，不设则随机生成 6 位数字密码） ==========
# ADMIN_PASSWORD=  # 设为你的密码，不设置则自动随机生成

# ========== 服务端口 ==========
SERVER_PORT=3012

# ========== 公网访问地址（供 Seedance 等第三方服务下载参考图/视频，部署时改为你的域名） ==========
PUBLIC_URL=https://your-domain.com

# ========== MongoDB ==========
# Docker 部署必须设置 MONGO_ROOT_PASS，本地开发可不填
MONGO_ROOT_PASS=请修改为强密码
MONGO_URI=mongodb://storycine_user:请修改密码@localhost:27017/storycine?authSource=storycine
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=storycine
MONGO_USER=storycine_user
MONGO_PASSWORD=请修改密码
MONGO_AUTH_SOURCE=storycine

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=请修改为强密码

# ========== MinIO ==========
MINIO_ROOT_USER=请修改用户名
MINIO_ROOT_PASSWORD=请修改为强密码
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=请修改为强密码
MINIO_SECRET_KEY=请修改为强密码
MINIO_BUCKET=storycine

# ========== LLM 大模型（全部空值，用户自行填写） ==========
DEEPSEEK_API_KEY=

# ========== 火山引擎 AK/SK（用于拉取音色列表等管理接口）==========
VOLCANO_ACCESS_KEY=
VOLCANO_SECRET_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=doubao-seedance-2-0-260128

TONGYI_API_KEY=
TONGYI_BASE_URL=
TONGYI_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

LANGGRAPH_API_KEY=
LANGGRAPH_PROJECT_ID=

# ========== 图像/视频模型 ==========
JIMENG_API_KEY=
JIMENG_BASE_URL=

WAN27_API_KEY=
WAN27_BASE_URL=
